#!/bin/sh
# Source launcher for Project Raven Light; never implicitly requests compute.
set -eu
RAVEN_SOURCE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$RAVEN_SOURCE_ROOT/.venv/bin/python" ]; then
    exec "$RAVEN_SOURCE_ROOT/.venv/bin/python" "$RAVEN_SOURCE_ROOT/scripts/raven_bootstrap.py" light "$@"
fi
exec python3 "$RAVEN_SOURCE_ROOT/scripts/raven_bootstrap.py" light "$@"
