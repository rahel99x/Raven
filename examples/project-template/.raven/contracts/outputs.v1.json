{
  "version": 1,
  "outputs": [
    {"path": "run.json", "required": true, "format": "json", "max_bytes": 1048576,
     "required_keys": ["schema", "run_id", "experiment_id", "attempt", "state", "paths"]},
    {"path": "logs.json", "required": true, "format": "json", "max_bytes": 262144,
     "required_keys": ["schema", "run_id", "logs"]},
    {"path": "summary.json", "required": true, "format": "json", "max_bytes": 1048576,
     "required_keys": ["schema", "id", "name", "state", "runtime_seconds", "results"]},
    {"path": "metrics.jsonl", "required": true, "format": "text", "min_bytes": 1, "max_bytes": 8388608},
    {"path": "outputs/results.json", "required": true, "format": "json", "max_bytes": 65536,
     "required_keys": ["estimated_pi", "absolute_error", "terms"]}
  ]
}
