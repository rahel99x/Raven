[importlinter]
root_package = raven

[importlinter:contract:transport]
name = Transport primitives cannot import application owners
type = forbidden
source_modules =
    raven.transport
forbidden_modules =
    raven.controller
    raven.model
    raven.slurm
    raven.remote
    raven.operations
    raven.terminal_service
    raven.raven_worker

[importlinter:contract:command-handlers]
name = Core command callbacks use context APIs instead of scheduler owners
type = forbidden
source_modules =
    raven.command_handlers
forbidden_modules =
    raven.controller
    raven.slurm
    raven.remote
    raven.raven_allocation

[importlinter:contract:presentation-contracts]
name = Pure terminal contracts cannot import application or gesture owners
type = forbidden
source_modules =
    raven.ui.focus
    raven.ui.geometry
    raven.ui.catalog
    raven.ui.keys
forbidden_modules =
    raven.controller
    raven.screen
    raven.views
    raven.workbench
    raven.interaction
    raven.chart_interaction
    raven.scrollbars
    raven.research
    raven.sampler
    raven.model
    raven.operations
    raven.slurm
    raven.remote

[importlinter:contract:log-path-domain]
name = Job log path resolution is independent of terminal presentation
type = forbidden
source_modules =
    raven.log_paths
forbidden_modules =
    raven.controller
    raven.screen
    raven.views
    raven.research
    raven.project_ui

[importlinter:contract:application-reader-ports]
name = Application readers use input and callback ports instead of UI owners
type = forbidden
source_modules =
    raven.research
    raven.science_analysis
    raven.planning_input
    raven.series_settings
    raven.projects
    raven.metrics
    raven.log_catalog
forbidden_modules =
    raven.controller
    raven.screen
    raven.views
    raven.workbench
    raven.project_ui
    raven.job_selection
    raven.navigation_ui
    raven.setup_ui
    raven.metric_live
    raven.job_panels

[importlinter:contract:cadence-domain]
name = Cadence arithmetic and preferences are independent of UI and collectors
type = forbidden
source_modules =
    raven.cadence
    raven.refresh_preferences
forbidden_modules =
    raven.refresh_rate
    raven.metric_live
    raven.metric_sampling
    raven.metric_sampling_runtime
    raven.telemetry_settings
    raven.telemetry_settings_ui
    raven.setup_ui
    raven.sampler
    raven.research
    raven.slurm

[importlinter:contract:canonical-application-services]
name = Canonical application and capture services cannot import interactive owners
type = forbidden
source_modules =
    raven.operation_support
    raven.execution.policy
    raven.execution.admission
    raven.execution.worker
    raven.execution.planning
    raven.collection
    raven.recordings.archive
    raven.recordings.publication
    raven.recordings.retention
    raven.recordings.storage
    raven.terminal.sessions
    raven.terminal.session_state
    raven.terminal.evidence
    raven.tracing.capture
    raven.tracing.protocol
    raven.tracing.provenance
    raven.tracing.document
    raven.tracing.export
    raven.tracing.stream
    raven.tracing.stream_export
forbidden_modules =
    raven.controller
    raven.screen
    raven.views
    raven.workbench
    raven.jobs.panels
    raven.jobs.selection
    raven.job_logs.workbench
    raven.job_logs.tools
    raven.terminal.ui
    raven.terminal.workflows
    raven.terminal.playback
    raven.terminal.fusion
    raven.terminal.diagnostics
    raven.tracing.ui
    raven.tracing.browser
    raven.tracing.timeline_ui
