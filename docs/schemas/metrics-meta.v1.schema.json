{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven optional metric semantics and client coverage",
  "type": "object",
  "required": [
    "schema",
    "client",
    "kinds",
    "coalesced",
    "rank_policy"
  ],
  "properties": {
    "schema": {
      "const": "raven.metrics-meta/v1"
    },
    "client": {
      "type": "object",
      "required": [
        "api_version"
      ],
      "properties": {
        "api_version": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "kinds": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f=]+$"
      },
      "additionalProperties": {
        "enum": [
          "objective",
          "residual",
          "throughput",
          "progress",
          "conserved",
          "error",
          "gauge"
        ]
      }
    },
    "coalesced": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f=]+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    },
    "units": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f=]+$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$"
      }
    },
    "baselines": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[^\\x00-\\x1f\\x7f=]+$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "rank_policy": {
      "type": "object",
      "required": [
        "mode",
        "rank"
      ],
      "properties": {
        "mode": {
          "enum": [
            "coordinator",
            "all_ranks"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "helper": {
          "type": "boolean"
        },
        "coverage": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "streams": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    }
  },
  "additionalProperties": true,
  "description": "Optional descriptive sidecar; metrics.jsonl remains header-free. Numeric baselines are first producer observations, never invented tolerances. Readers cap the complete file at 65536 bytes. Unknown descriptive extensions never authorize reads or actions."
}
