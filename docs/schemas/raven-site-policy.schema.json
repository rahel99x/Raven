            "cluster_id": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[^\\u0000\\r\\n]*$"
            },
            "policy_file": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000\\r\\n]*$"
            }
          }
        },
