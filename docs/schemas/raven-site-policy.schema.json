              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 0.001,
              "maximum": 1099511627776
            },
            "max_response_records": {
              "type": "integer",
              "minimum": 0.001,
              "maximum": 1099511627776
            },
            "live_batch_jobs": {
              "type": "integer",
              "minimum": 0.001,
              "maximum": 1099511627776
            },
            "circuit_failures": {
              "type": "integer",
              "minimum": 0.001,
              "maximum": 1099511627776
            },
            "circuit_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 31536000
            },
            "filesystem_metadata_per_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "file_bytes_per_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1099511627776
            },
            "local_processes_per_minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "service_failure": {
              "enum": [
                "cached-only"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
