                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 31536000
                },
                "wall_seconds": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 31536000
                },
                "input_bytes": {
                  "type": "integer",
                  "minimum": 0.001,
                  "maximum": 1099511627776
                },
                "output_bytes": {
                  "type": "integer",
                  "minimum": 0.001,
                  "maximum": 1099511627776
