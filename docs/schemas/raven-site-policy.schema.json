              "type": "number",
              "minimum": 0.1,
              "maximum": 31536000
            },
            "inventory_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 31536000
            },
            "details_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 31536000
            },
            "live_statistics": {
              "enum": [
                "off",
                "selected-on-demand"
              ]
            },
            "live_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 31536000
            },
            "gpu": {
              "enum": [
                "existing-telemetry",
                "off"
              ]
            },
            "weather_probes": {
              "const": false
