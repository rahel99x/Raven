{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven.local/schemas/factorial-design.v1.schema.json",
  "title": "Declared bounded factorial experiment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "raven.factorial-design/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "order": {
      "enum": [
        "randomized",
        "blocked"
      ]
    },
    "repetitions": {
      "type": "integer",
      "minimum": 3,
      "maximum": 10
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "levels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                },
                "arguments": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "maxLength": 4096
                  }
                }
              },
              "required": [
                "id",
                "arguments"
              ]
            }
          }
        },
        "required": [
          "id",
          "levels"
        ]
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "number",
          "minimum": -1e+100,
          "maximum": 1e+100
        },
        "absolute": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+100
        },
        "relative": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+100
        },
        "semantic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "reference",
        "absolute",
        "relative",
        "semantic",
        "unit"
      ]
    },
    "recipe": {
      "allOf": [
        {
          "$ref": "investigation-diagnostic-campaign.schema.json"
        },
        {
          "properties": {
            "kind": {
              "const": "campaign"
            },
            "command": {
              "contains": {
                "const": "{result}"
              }
            },
            "limits": {
              "properties": {
                "repeats": {
                  "const": 1
                }
              }
            },
            "cases": {
              "maxItems": 1,
              "minItems": 1,
              "items": {
                "properties": {
                  "arguments": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "incompatible": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 4,
        "additionalProperties": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        }
      }
    }
  },
  "required": [
    "schema",
    "id",
    "seed",
    "order",
    "repetitions",
    "factors",
    "equivalence",
    "recipe"
  ],
  "description": "Runtime validates unique compatible factors and resource feasibility; incompatible full-factorial cells are refused rather than silently omitted."
}
