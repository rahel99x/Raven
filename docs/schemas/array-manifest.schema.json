{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahel99x/Raven/blob/main/docs/schemas/array-manifest.schema.json",
  "title": "Raven scientific array-index manifest v1",
  "description": "Bounded to 4 MiB. Index and scientific id must each be unique across entries (validated by Raven). Cluster matches exactly; empty string matches only unlabelled cluster records. Input/output paths are declarations and are never opened by this feature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cluster", "array_id", "entries"],
  "properties": {
    "schema": {"const": "raven.array-manifest/v1"},
    "cluster": {"type": "string", "maxLength": 128},
    "array_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$", "description": "Canonical positive decimal parent job ID, at most 9223372036854775807."},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["index", "id"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "label": {"type": "string", "minLength": 1, "maxLength": 512},
          "parameters": {
            "type": "object", "maxProperties": 64,
            "propertyNames": {"minLength": 1, "maxLength": 128},
            "additionalProperties": {
              "oneOf": [
                {"type": "string", "maxLength": 1024},
                {"type": "number", "minimum": -1e308, "maximum": 1e308},
                {"type": "boolean"}, {"type": "null"}
              ]
            }
          },
          "inputs": {"$ref": "#/$defs/paths"},
          "outputs": {"$ref": "#/$defs/paths"}
        }
      }
    }
  },
  "$defs": {"paths": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}
}
