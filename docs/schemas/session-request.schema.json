{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven.readthedocs.io/schemas/session-request.schema.json",
  "title": "Raven read-only session request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "op", "session", "epoch", "cursor"],
  "properties": {
    "schema": {"const": "raven.session/v1"},
    "version": {"const": 1},
    "op": {"enum": ["hello", "snapshot", "events"]},
    "session": {"type": "string", "pattern": "^([0-9a-f]{32})?$"},
    "epoch": {"type": "string", "pattern": "^([0-9a-f]{32})?$"},
    "cursor": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  }
}
