{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven native planning bundle v1",
  "description": "Native source for explicit --planning-file, file-based analysis commands, or run.json paths.planning / per-view bindings. Publishers select actual measured histories, recipes and scheduler observations; attaching a file does not generate observations.",
  "type": "object",
  "required": [
    "version",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "raven.planning"
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "simulated": {
      "type": "boolean"
    },
    "now": {
      "type": "number",
      "minimum": 0,
      "maximum": 253402300799,
      "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
    },
    "coverage": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "summary.v1.schema.json#/properties/name"
        },
        "partition": {
          "$ref": "summary.v1.schema.json#/properties/partition"
        },
        "account": {
          "$ref": "summary.v1.schema.json#/properties/account"
        },
        "qos": {
          "$ref": "summary.v1.schema.json#/properties/qos"
        },
        "cpus": {
          "$ref": "summary.v1.schema.json#/properties/cpus"
        },
        "nodes": {
          "$ref": "summary.v1.schema.json#/properties/nodes"
        },
        "gpus": {
          "$ref": "summary.v1.schema.json#/properties/gpus"
        },
        "gpu_type": {
          "$ref": "summary.v1.schema.json#/properties/gpu_type"
        },
        "mem_bytes": {
          "$ref": "summary.v1.schema.json#/properties/mem_bytes"
        },
        "time_seconds": {
          "$ref": "summary.v1.schema.json#/properties/time_seconds"
        },
        "script_sha256": {
          "$ref": "summary.v1.schema.json#/properties/script_sha256"
        },
        "input_size": {
          "$ref": "summary.v1.schema.json#/properties/input_size"
        },
        "parameters": {
          "$ref": "summary.v1.schema.json#/properties/parameters"
        },
        "memory_scope": {
          "$ref": "summary.v1.schema.json#/properties/memory_scope"
        }
      },
      "description": "Exact workload/resource identity to analyze. Unknown query fields are omitted/null; that does not authorize pooling incompatible or ambiguous cohorts."
    },
    "history": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/historyRecord"
      }
    },
    "queue_history": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/jobRecord"
      },
      "description": "Observed historical submissions/starts, not guessed waits. Native queue comparisons require concrete matching resources and sufficient independent outcomes."
    },
    "jobs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/jobRecord"
      }
    },
    "job_id": {
      "allOf": [
        {
          "$ref": "summary.v1.schema.json#/properties/job_id"
        },
        {
          "not": {
            "type": "null"
          }
        }
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/forecastObservation"
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "scaling": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/scalingRecord"
      }
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/scalingRecord"
      }
    },
    "mode": {
      "enum": [
        "strong",
        "weak"
      ]
    },
    "baseline": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "workflow": {
      "$ref": "#/$defs/workflowRecipe"
    },
    "details": {
      "type": "object",
      "description": "Optional exact frozen Slurm details by job ID. Match the current scheduler snapshot shape; omitted facts remain unknown."
    },
    "partitions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object"
      }
    },
    "nodes": {
      "type": "object",
      "description": "Frozen Raven nodemap shape for placement screening, not a replacement for scheduler allocation decisions."
    },
    "share": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object"
      }
    },
    "health": {
      "type": "object",
      "description": "Optional source freshness/status metadata from the same snapshot."
    }
  },
  "$defs": {
    "historyRecord": {
      "type": "object",
      "if": {
        "required": [
          "schema"
        ]
      },
      "then": {
        "$ref": "summary.v1.schema.json"
      },
      "else": {
        "type": "object",
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "id": {
            "$ref": "summary.v1.schema.json#/properties/id"
          },
          "name": {
            "$ref": "summary.v1.schema.json#/properties/name"
          },
          "state": {
            "$ref": "summary.v1.schema.json#/properties/state"
          },
          "partition": {
            "$ref": "summary.v1.schema.json#/properties/partition"
          },
          "account": {
            "$ref": "summary.v1.schema.json#/properties/account"
          },
          "qos": {
            "$ref": "summary.v1.schema.json#/properties/qos"
          },
          "cpus": {
            "$ref": "summary.v1.schema.json#/properties/cpus"
          },
          "nodes": {
            "$ref": "summary.v1.schema.json#/properties/nodes"
          },
          "gpus": {
            "$ref": "summary.v1.schema.json#/properties/gpus"
          },
          "gpu_type": {
            "$ref": "summary.v1.schema.json#/properties/gpu_type"
          },
          "mem_bytes": {
            "$ref": "summary.v1.schema.json#/properties/mem_bytes"
          },
          "time_seconds": {
            "$ref": "summary.v1.schema.json#/properties/time_seconds"
          },
          "runtime_seconds": {
            "$ref": "summary.v1.schema.json#/properties/runtime_seconds"
          },
          "memory_bytes": {
            "$ref": "summary.v1.schema.json#/properties/memory_bytes"
          },
          "memory_scope": {
            "$ref": "summary.v1.schema.json#/properties/memory_scope"
          },
          "cpu_seconds": {
            "$ref": "summary.v1.schema.json#/properties/cpu_seconds"
          },
          "script_sha256": {
            "$ref": "summary.v1.schema.json#/properties/script_sha256"
          },
          "parameters": {
            "$ref": "summary.v1.schema.json#/properties/parameters"
          },
          "input_size": {
            "$ref": "summary.v1.schema.json#/properties/input_size"
          },
          "start": {
            "$ref": "summary.v1.schema.json#/properties/start"
          },
          "end": {
            "$ref": "summary.v1.schema.json#/properties/end"
          },
          "submit": {
            "$ref": "summary.v1.schema.json#/properties/submit"
          },
          "job_id": {
            "$ref": "summary.v1.schema.json#/properties/job_id"
          },
          "experiment_id": {
            "$ref": "summary.v1.schema.json#/properties/experiment_id"
          },
          "attempt": {
            "$ref": "summary.v1.schema.json#/properties/attempt"
          },
          "project_id": {
            "$ref": "summary.v1.schema.json#/properties/project_id"
          },
          "exit_code": {
            "$ref": "summary.v1.schema.json#/properties/exit_code"
          },
          "workers": {
            "$ref": "summary.v1.schema.json#/properties/workers"
          },
          "problem_size": {
            "$ref": "summary.v1.schema.json#/properties/problem_size"
          },
          "repeat": {
            "$ref": "summary.v1.schema.json#/properties/repeat"
          },
          "fingerprint": {
            "$ref": "summary.v1.schema.json#/properties/fingerprint"
          },
          "work_units": {
            "$ref": "summary.v1.schema.json#/properties/work_units"
          },
          "results": {
            "$ref": "summary.v1.schema.json#/properties/results"
          },
          "metadata": {
            "$ref": "summary.v1.schema.json#/properties/metadata"
          },
          "elapsed": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "cpu_time": {
            "type": [
              "number",
              "null"
            ]
          },
          "rss": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_rss": {
            "type": [
              "number",
              "null"
            ]
          },
          "req_mem": {
            "type": [
              "number",
              "null"
            ]
          },
          "mem_req": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "description": "Canonical summaries carry schema raven.summary/v1. Legacy native records without a schema marker remain accepted; native models independently check concrete identities and eligibility."
    },
    "jobRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "summary.v1.schema.json#/properties/id"
        },
        "name": {
          "$ref": "summary.v1.schema.json#/properties/name"
        },
        "state": {
          "$ref": "summary.v1.schema.json#/properties/state"
        },
        "partition": {
          "$ref": "summary.v1.schema.json#/properties/partition"
        },
        "account": {
          "$ref": "summary.v1.schema.json#/properties/account"
        },
        "qos": {
          "$ref": "summary.v1.schema.json#/properties/qos"
        },
        "cpus": {
          "$ref": "summary.v1.schema.json#/properties/cpus"
        },
        "nodes": {
          "$ref": "summary.v1.schema.json#/properties/nodes"
        },
        "gpus": {
          "$ref": "summary.v1.schema.json#/properties/gpus"
        },
        "gpu_type": {
          "$ref": "summary.v1.schema.json#/properties/gpu_type"
        },
        "mem_bytes": {
          "$ref": "summary.v1.schema.json#/properties/mem_bytes"
        },
        "time_seconds": {
          "$ref": "summary.v1.schema.json#/properties/time_seconds"
        },
        "runtime_seconds": {
          "$ref": "summary.v1.schema.json#/properties/runtime_seconds"
        },
        "memory_bytes": {
          "$ref": "summary.v1.schema.json#/properties/memory_bytes"
        },
        "memory_scope": {
          "$ref": "summary.v1.schema.json#/properties/memory_scope"
        },
        "cpu_seconds": {
          "$ref": "summary.v1.schema.json#/properties/cpu_seconds"
        },
        "script_sha256": {
          "$ref": "summary.v1.schema.json#/properties/script_sha256"
        },
        "parameters": {
          "$ref": "summary.v1.schema.json#/properties/parameters"
        },
        "input_size": {
          "$ref": "summary.v1.schema.json#/properties/input_size"
        },
        "start": {
          "$ref": "summary.v1.schema.json#/properties/start"
        },
        "end": {
          "$ref": "summary.v1.schema.json#/properties/end"
        },
        "submit": {
          "$ref": "summary.v1.schema.json#/properties/submit"
        },
        "job_id": {
          "$ref": "summary.v1.schema.json#/properties/job_id"
        },
        "experiment_id": {
          "$ref": "summary.v1.schema.json#/properties/experiment_id"
        },
        "attempt": {
          "$ref": "summary.v1.schema.json#/properties/attempt"
        },
        "project_id": {
          "$ref": "summary.v1.schema.json#/properties/project_id"
        },
        "exit_code": {
          "$ref": "summary.v1.schema.json#/properties/exit_code"
        },
        "workers": {
          "$ref": "summary.v1.schema.json#/properties/workers"
        },
        "problem_size": {
          "$ref": "summary.v1.schema.json#/properties/problem_size"
        },
        "repeat": {
          "$ref": "summary.v1.schema.json#/properties/repeat"
        },
        "fingerprint": {
          "$ref": "summary.v1.schema.json#/properties/fingerprint"
        },
        "work_units": {
          "$ref": "summary.v1.schema.json#/properties/work_units"
        },
        "results": {
          "$ref": "summary.v1.schema.json#/properties/results"
        },
        "metadata": {
          "$ref": "summary.v1.schema.json#/properties/metadata"
        },
        "est_start": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 253402300799,
              "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "dependency": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "limit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "limit_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+100
        },
        "mem_req": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "req_mem": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+100
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+100
        },
        "array_job_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "array_task_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "user": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "additionalProperties": true
    },
    "forecastObservation": {
      "type": "object",
      "required": [
        "job_id",
        "submit",
        "issued_at",
        "predicted_start"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "summary.v1.schema.json#/properties/name"
        },
        "partition": {
          "$ref": "summary.v1.schema.json#/properties/partition"
        },
        "account": {
          "$ref": "summary.v1.schema.json#/properties/account"
        },
        "qos": {
          "$ref": "summary.v1.schema.json#/properties/qos"
        },
        "cpus": {
          "$ref": "summary.v1.schema.json#/properties/cpus"
        },
        "nodes": {
          "$ref": "summary.v1.schema.json#/properties/nodes"
        },
        "gpus": {
          "$ref": "summary.v1.schema.json#/properties/gpus"
        },
        "gpu_type": {
          "$ref": "summary.v1.schema.json#/properties/gpu_type"
        },
        "mem_bytes": {
          "$ref": "summary.v1.schema.json#/properties/mem_bytes"
        },
        "time_seconds": {
          "$ref": "summary.v1.schema.json#/properties/time_seconds"
        },
        "job_id": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/job_id"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "submit": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/submit"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "issued_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 253402300799,
          "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
        },
        "predicted_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 253402300799,
          "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
        },
        "actual_start": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 253402300799,
              "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
            },
            {
              "type": "null"
            }
          ]
        },
        "first_issued_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 253402300799,
          "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
        },
        "first_predicted_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 253402300799,
          "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
        },
        "last_observed_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 253402300799,
          "description": "Unix epoch seconds in UTC. Omit or use null when unknown; never local time strings."
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "time_basis": {
          "enum": [
            "epoch",
            "local_assumed"
          ]
        }
      },
      "description": "Observed scheduler point and outcome, recorded before the actual start. Never backfill guessed issued_at or predicted_start. Native calibration additionally checks chronology, distinct submitted-job identities, matching resource cohorts, and forecast lead bands."
    },
