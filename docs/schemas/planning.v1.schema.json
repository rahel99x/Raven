              }
            }
          ]
        },
        "gpus": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/gpus"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "gpu_type": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/gpu_type"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "mem_bytes": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/mem_bytes"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "time_seconds": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/time_seconds"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "script_sha256": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/script_sha256"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "input_size": {
          "allOf": [
            {
              "$ref": "summary.v1.schema.json#/properties/input_size"
            },
            {
              "not": {
                "type": "null"
              }
            }
          ]
        },
        "parameters": {
          "$ref": "summary.v1.schema.json#/properties/parameters"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "estimated_runtime_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3162240000,
          "exclusiveMinimum": 0
        }
      },
      "description": "Concrete prospective resource request. cpus/gpus/mem_bytes are allocation-wide totals. An estimated_runtime_seconds value is an explicit unvalidated assumption, never measured evidence. Native validation requires cpus>=nodes."
    },
    "scalingRecord": {
      "type": "object",
      "required": [
        "workers",
        "problem_size",
        "parameters",
        "script_sha256",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "summary.v1.schema.json#/properties/id"
        },
        "name": {
          "$ref": "summary.v1.schema.json#/properties/name"
        },
        "state": {
          "$ref": "summary.v1.schema.json#/properties/state"
        },
        "partition": {
          "$ref": "summary.v1.schema.json#/properties/partition"
        },
        "account": {
