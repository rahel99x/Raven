{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahel99x/Raven/docs/schemas/job-index.v1.schema.json",
  "title": "Raven exact job attempt index",
  "description": "A publisher-maintained pointer to exact run directories. Multiple attempts stay ambiguous unless the scheduler reports an exact restart count. Cluster collisions produce a separate ambiguity sentinel.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "job_id", "cluster", "run_ids"],
      "properties": {
        "schema": {"const": "raven.job-index/v1"},
        "job_id": {"type": "string", "pattern": "^[0-9]+(?:_[0-9]+)?(?:\\+[0-9]+)?$", "maxLength": 128},
        "cluster": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
        "run_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "job_id", "clusters"],
      "properties": {
        "schema": {"const": "raven.job-index-ambiguous/v1"},
        "job_id": {"type": "string", "pattern": "^[0-9]+(?:_[0-9]+)?(?:\\+[0-9]+)?$", "maxLength": 128},
        "clusters": {"type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "maxLength": 128}}
      }
    }
  ]
}
