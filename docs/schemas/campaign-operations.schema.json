{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven.dev/schemas/campaign-operations.schema.json",
  "title": "Raven campaign operation manifests",
  "description": "Local, explicit recovery and campaign contracts. Runtime validation additionally verifies files, resource conflicts, receipts, and connection identities.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "script",
        "script_sha256",
        "checkpoint",
        "compatibility",
        "source_job"
      ],
      "properties": {
        "schema": {
          "const": "raven.checkpoint-restart/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sbatch": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoint": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "complete"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "complete": {
              "const": true
            }
          }
        },
        "compatibility": {
          "type": "object",
          "required": [
            "expected",
            "actual"
          ],
          "properties": {
            "expected": {
              "type": "object",
              "required": [
                "application",
                "format",
                "runtime"
              ],
              "properties": {
                "application": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "format": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "runtime": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "actual": {
              "type": "object",
              "required": [
                "application",
                "format",
                "runtime"
              ],
              "properties": {
                "application": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "format": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "runtime": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        },
        "source_job": {
          "type": "object",
          "required": [
            "id",
            "cluster",
            "start"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}(?:_[0-9]{1,10}|\\+[0-9]{1,5})?$"
            },
            "cluster": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "start": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "id",
        "script",
        "budget",
        "parameters"
      ],
      "properties": {
        "schema": {
          "const": "raven.parameter-search/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sbatch": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            }
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "trial",
              "status"
            ],
            "properties": {
              "trial": {
                "type": "string",
                "pattern": "^[0-9a-f]{24}$"
              },
              "status": {
                "enum": [
                  "success",
                  "scientific_failed",
                  "infrastructure_failed"
                ]
              },
              "metric": {
                "type": "number"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "success"
                    }
                  }
                },
                "then": {
                  "required": [
                    "metric"
                  ]
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "cpus",
        "memory_mb",
        "tasks"
      ],
      "properties": {
        "schema": {
          "const": "raven.packed-tasks/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "walltime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sbatch": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "id",
              "argv",
              "memory_mb"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "cpus": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "memory_mb": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 604800
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "id",
        "cores",
        "memory_mb",
        "max_jobs"
      ],
      "properties": {
        "schema": {
          "const": "raven.dask-pool/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "max_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "min_jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "adaptive": {
          "type": "boolean"
        },
        "walltime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "queue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "interface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "local_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema",
        "components"
      ],
      "properties": {
        "schema": {
          "const": "raven.heterogeneous-allocation/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "walltime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "resources",
              "argv"
            ],
            "properties": {
              "resources": {
                "type": "object",
                "required": [
                  "nodes",
                  "ntasks"
                ],
                "properties": {
                  "nodes": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "ntasks": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "ntasks-per-node": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "cpus-per-task": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "mem": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "mem-per-cpu": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "gpus": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "gpus-per-node": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "gpus-per-task": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "gres": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "partition": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "account": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "qos": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "constraint": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "reservation": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "exclusive": {
                    "const": true
                  }
                },
                "additionalProperties": false
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
