{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven existing-script launch plan v1",
  "description": "Pure preview plus runtime-frozen source and settings. Runtime fields may be added during materialization. Static readiness does not claim Slurm acceptance or scientific evidence.",
  "type": "object",
  "required": [
    "schema",
    "project_root",
    "project_source",
    "script",
    "script_relative",
    "script_sha256",
    "submit_dir",
    "workdir",
    "execution",
    "interpreter",
    "script_args",
    "sbatch_header",
    "sbatch_options",
    "effective_options",
    "option_sources",
    "features",
    "settings",
    "readiness"
  ],
  "properties": {
    "schema": {
      "const": "raven.launch-plan/v1"
    },
    "execution": {
      "enum": [
        "local",
        "slurm"
      ]
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 13,
      "items": {
        "enum": [
          "experiment",
          "arrays",
          "evidence",
          "artifacts",
          "passport",
          "submit",
          "resources",
          "forecast",
          "blockers",
          "tradeoffs",
          "scaling",
          "workflow",
          "operations"
        ]
      }
    },
    "gpu": {
      "type": "boolean"
    },
    "trace": {
      "type": "boolean"
    },
    "auto_export": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object"
        }
      ]
    },
    "script_args": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "interpreter": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "sbatch_header": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "sbatch_options": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "effective_options": {
      "type": "object"
    },
    "option_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "settings": {
      "$ref": "automation-settings.v1.schema.json#/$defs/launch"
    },
    "setting_sources": {
      "type": "object"
    },
    "readiness": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "feature",
          "label",
          "status",
          "reason"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "will-verify",
              "needs-input",
              "unsupported",
              "recording",
              "partial",
              "failed"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "mutations": {
      "type": "integer",
      "minimum": 0
    },
    "script_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "project_root": {
      "type": "string",
      "maxLength": 4096
    },
    "project_source": {
      "type": "string",
      "maxLength": 4096
    },
    "script": {
      "type": "string",
      "maxLength": 4096
    },
    "script_relative": {
      "type": "string",
      "maxLength": 4096
    },
    "submit_dir": {
      "type": "string",
      "maxLength": 4096
    },
    "workdir": {
      "type": "string",
      "maxLength": 4096
    },
    "filesystem_host": {
      "type": "string",
      "maxLength": 4096
    },
    "name": {
      "type": "string",
      "maxLength": 4096
    },
    "account": {
      "type": "string",
      "maxLength": 4096
    },
    "account_source": {
      "type": "string",
      "maxLength": 4096
    },
    "export_policy": {
      "type": "string",
      "maxLength": 4096
    },
    "recipe": {
      "type": "string",
      "maxLength": 4096
    },
    "receipt_file": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
