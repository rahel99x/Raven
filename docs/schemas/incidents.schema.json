{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven historical infrastructure events",
  "type": "object", "required": ["schema", "events"],
  "properties": {
    "schema": {"const": "raven.incidents/v1"},
    "events": {"type": "array", "maxItems": 20000, "items": {
      "type": "object", "required": ["cluster", "nodes", "start"],
      "properties": {
        "cluster": {"type": "string", "minLength": 1, "maxLength": 256},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "start": {"$ref": "#/$defs/time"}, "end": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "state": {"type": "string", "minLength": 1, "maxLength": 256},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }}
  },
  "$defs": {"time": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 253402300799}, {"type": "string", "format": "date-time"}]}},
  "description": "At most 4 MiB. Times are Unix seconds or ISO timestamps with an explicit offset. End must be after start; null or missing end denotes ongoing incident. Nodes must be exact expanded hostnames. Overlap is evidence, not a causal attribution."
}
