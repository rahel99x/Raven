{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rahel99x/Slurm-Tower/main/docs/schemas/summary-query.schema.json",
  "title": "summary query",
  "description": "Only count, sum, min and max are supported. The paired source and native reader establish selected-column validity and coverage.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tower.summary-query/v1"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "runtime-common.schema.json#/$defs/identifier"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "count",
          "sum",
          "min",
          "max"
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "fields",
    "operations"
  ],
  "additionalProperties": false
}
