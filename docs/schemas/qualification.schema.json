{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahel99x/Slurm-Tower/docs/schemas/qualification.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tower.qualification/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "format": {
            "enum": [
              "tower-evidence",
              "perfetto-json",
              "caliper-json-records",
              "workflow-run-ro-crate",
              "otlp-json-traces"
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "cluster": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "job_id": {
                "type": "string",
                "pattern": "^[0-9]+(?:_[0-9]+)?(?:\\+[0-9]+)?(?:\\.[A-Za-z0-9_-]+)?$"
              },
              "attempt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "process_start": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "pid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "rank": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "thread": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "task": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "cluster",
              "job_id",
              "attempt"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "pid": [
                "node",
                "process_start"
              ]
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "min_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              },
              "max_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              },
              "mode": {
                "enum": [
                  "events",
                  "samples",
                  "aggregates",
                  "provenance",
                  "mixed"
                ]
              }
            },
            "required": [
              "min_records",
              "max_records"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "format",
          "identity",
          "expect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "checks"
  ],
  "additionalProperties": false
}
