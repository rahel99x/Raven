{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rahel99x/Raven/main/docs/schemas/execution-model.schema.json",
  "title": "execution model",
  "description": "Native validation checks resource kinds/references, unique IDs, dependency existence/acyclicity, fixed rank identities, scenario ratios and bounded arithmetic. A structural schema does not establish model fidelity.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "raven.execution-model/v1"
    },
    "workload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
      }
    },
    "resources": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "runtime-common.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "cpu",
              "network",
              "io"
            ]
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1e+100
          },
          "latency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1e+100
          }
        },
        "required": [
          "kind",
          "rate"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "domain": {
      "type": "object",
      "properties": {
        "minimum_rate_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maximum_rate_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 1e+100
        },
        "fixed_workload": {
          "const": true
        },
        "max_validation_relative_error": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Declared acceptance threshold for each held-out relative error. Without this policy the prediction is unqualified. Any failed held-out case withdraws predictions."
        }
      },
      "required": [
        "minimum_rate_ratio",
        "maximum_rate_ratio",
        "fixed_workload"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "$ref": "runtime-common.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "runtime-common.schema.json#/$defs/identifier"
      }
    },
    "routes": {
      "type": "object",
      "maxProperties": 16384,
      "additionalProperties": {
        "$ref": "runtime-common.schema.json#/$defs/identifier"
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/+\\-]{0,127}->[A-Za-z0-9][A-Za-z0-9_.:@/+\\-]{0,127}$",
        "not": {
          "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "runtime-common.schema.json#/$defs/identifier"
          },
          "kind": {
            "enum": [
              "cpu",
              "network",
              "io"
            ]
          },
          "work": {
            "type": "number",
            "minimum": 0,
            "maximum": 1e+100
          },
          "depends": {
            "type": "array",
            "items": {
              "$ref": "runtime-common.schema.json#/$defs/identifier"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "resource": {
            "$ref": "runtime-common.schema.json#/$defs/identifier"
          },
          "rank": {
            "$ref": "runtime-common.schema.json#/$defs/identifier"
          },
          "source": {
            "$ref": "runtime-common.schema.json#/$defs/identifier"
          },
          "destination": {
            "$ref": "runtime-common.schema.json#/$defs/identifier"
          }
        },
        "required": [
          "id",
          "kind",
          "work",
          "depends"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "resource"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rank"
                  ]
                },
                {
                  "required": [
                    "source"
                  ]
                },
                {
                  "required": [
                    "destination"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "cpu"
              }
            },
            "required": [
              "rank"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "resource"
                  ]
                },
                {
                  "required": [
                    "source"
                  ]
                },
                {
                  "required": [
                    "destination"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "network"
              }
            },
            "required": [
              "source",
              "destination"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "resource"
                  ]
                },
                {
                  "required": [
                    "rank"
                  ]
                }
              ]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 20000
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "runtime-common.schema.json#/$defs/identifier"
          },
          "role": {
            "enum": [
              "calibration",
              "validation"
            ]
          },
          "scenario": {
            "$ref": "runtime-common.schema.json#/$defs/scenario"
          },
          "actual_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1e+100
          }
        },
        "required": [
          "id",
          "role",
          "scenario",
          "actual_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema",
    "workload",
    "resources",
    "events",
    "domain"
  ],
  "additionalProperties": false
}
