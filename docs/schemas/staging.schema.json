{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahel99x/Raven/docs/schemas/staging.schema.json",
  "title": "Raven declared verified staging manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "entries"],
  "properties": {
    "schema": {"const": "raven.staging/v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "retention": {"const": "keep-source", "default": "keep-source"},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "destination", "sha256", "size", "direction"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source": {"type": "string", "pattern": "^/", "maxLength": 4096},
          "destination": {"type": "string", "pattern": "^/", "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "direction": {"enum": ["input", "output"]}
        }
      }
    }
  }
}
