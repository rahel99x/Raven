{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven.local/schemas/phase-comparison.v1.schema.json",
  "title": "Experimental phase comparison input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reference",
    "candidate"
  ],
  "properties": {
    "schema": {
      "const": "raven.phase-comparison/v1"
    },
    "reference": {
      "$ref": "measurement-series.v1.schema.json"
    },
    "candidate": {
      "$ref": "measurement-series.v1.schema.json"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "max_gap": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "minimum": {
      "type": "integer",
      "minimum": 4,
      "maximum": 256
    },
    "penalty": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 100
    }
  },
  "$comment": "Runtime verifies exact one-attempt inputs, matching explicit units, selected metrics on both sides and bounded normalization/work. No alignment authorizes mutation."
}
