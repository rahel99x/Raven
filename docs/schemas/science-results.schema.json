{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven results v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "raven.results/v1"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": -1e+100,
              "maximum": 1e+100
            },
            "minProperties": 0
          }
        },
        "required": [
          "id",
          "metrics"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schema",
    "runs"
  ]
}
