{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raven.config/v1",
  "title": "Raven configuration",
  "type": "object",
  "required": [
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "raven.config/v1"
    },
    "profile": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000\\r\\n]*$"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "desktop",
            "slurm"
          ]
        },
        "cluster_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "policy_file": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]*$"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": [
            "local",
            "none",
            "ssh"
          ]
        },
        "host": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "user": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "credential_reference": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "ssh_options": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 64
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "enum": [
            "heavy",
            "light"
          ]
        },
        "heavy_target": {
          "enum": [
            "local",
            "slurm"
          ]
        },
        "heavy_requires_allocation": {
          "type": "boolean"
        },
        "desktop_execution": {
          "enum": [
            "disabled",
            "explicit"
          ]
        },
        "allow_login_heavy": {
          "const": false
        },
        "on_allocation_end": {
          "enum": [
            "light"
          ]
        },
        "worker_python": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "view",
              "scheduler-read",
              "scheduler-action",
              "local-files",
              "terminal",
              "heavy-analysis",
              "instrumentation"
            ]
          },
          "maxItems": 64
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "desktop",
            "slurm-cli"
          ]
        },
        "account": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "partition": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "qos": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
