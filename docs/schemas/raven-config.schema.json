        "tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "cpus_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "gpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "walltime_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1099511627776
        },
        "pending_timeout_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1099511627776
        },
        "idle_release_seconds": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1099511627776
        },
        "reuse": {
          "enum": [
            "explicit"
          ]
        },
        "auto_request_on_light_start": {
          "const": false
        },
        "auto_renew": {
          "const": false
        },
        "disconnect_policy": {
          "enum": [
            "stop-owned-worker"
          ]
        }
      }
