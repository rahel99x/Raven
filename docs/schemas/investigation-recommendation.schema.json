{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recommendation review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "tower.recommendation-review/v1"
    },
    "contract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Contract",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Exact attempt",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "attempt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "code_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputs_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environment_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "cluster",
            "job_id",
            "attempt"
          ]
        },
        "created": {
          "type": "number",
          "minimum": 0
        },
        "expires": {
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Evidence pin",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "sha256"
            ]
          },
          "maxItems": 1024,
          "minItems": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Evidence predicate",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 16,
                "minItems": 1
              },
              "op": {
                "enum": [
                  "eq",
                  "lt",
                  "le",
                  "gt",
                  "ge"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              }
            },
            "required": [
              "source",
              "path",
              "op",
              "value"
            ]
          },
          "maxItems": 256,
          "minItems": 1
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Evidence predicate",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 16,
                "minItems": 1
              },
              "op": {
                "enum": [
                  "eq",
                  "lt",
                  "le",
                  "gt",
                  "ge"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              }
            },
            "required": [
              "source",
              "path",
              "op",
              "value"
            ]
          },
          "maxItems": 256,
          "minItems": 1
        },
        "intervention": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "prediction": {},
        "alternatives": {}
      },
      "required": [
        "id",
        "identity",
        "created",
        "expires",
        "evidence",
        "preconditions",
        "acceptance",
        "intervention"
      ]
    },
    "snapshot": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Snapshot",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Exact attempt",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "attempt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "code_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputs_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environment_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "cluster",
            "job_id",
            "attempt"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Evidence",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "complete": {
                "type": "boolean"
              },
              "data": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "sha256",
              "complete",
              "data"
            ]
          },
          "maxItems": 1024,
          "minItems": 0
        }
      },
      "required": [
        "identity",
        "evidence"
      ]
    },
    "outcome": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Outcome",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Exact attempt",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "attempt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "code_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputs_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environment_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "cluster",
            "job_id",
            "attempt"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Evidence",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "complete": {
                "type": "boolean"
              },
              "data": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "sha256",
              "complete",
              "data"
            ]
          },
          "maxItems": 1024,
          "minItems": 0
        }
      },
      "required": [
        "contract_sha256",
        "experiment_id",
        "identity",
        "evidence"
      ]
    }
  },
  "required": [
    "schema",
    "contract",
    "snapshot"
  ]
}
