{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raven.local/schemas/measurement-series.v1.schema.json",
  "title": "Explicit attempt-scoped measurements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "series"
  ],
  "properties": {
    "schema": {
      "const": "raven.measurement-series/v1"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "metric",
          "unit",
          "samples"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "attempt",
              "job",
              "verified"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "attempt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "job": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "verified": {
                "const": true
              }
            }
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "samples": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "value"
              ],
              "properties": {
                "t": {
                  "type": "number"
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "phase": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capture",
              "sha256",
              "path",
              "source_id",
              "source_rows",
              "selector",
              "metric",
              "unit"
            ],
            "properties": {
              "capture": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "source_id": {
                "type": "integer",
                "minimum": 1
              },
              "source_rows": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "integer",
                  "minimum": 2
                }
              },
              "selector": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "maxLength": 128
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally requires finite numbers, increasing timestamps, unique attempt/metric pairs and one source row per sample. Identity assertions in files never authorize scheduler actions."
}
