{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven retained export CSV column contract v1",
  "description": "Canonical ordered columns; per-metric layout selects observation columns without changing their names or units. Identity and clock columns remain present. Empty numeric cells mean unavailable. Application unit defaults unspecified. Native source floats retain Python/JSON roundtrip precision; no display-width rounding.",
  "type": "object",
  "required": [
    "schema",
    "application",
    "gpu",
    "cpu-memory"
  ],
  "properties": {
    "schema": {
      "const": "raven.export-columns/v1"
    },
    "application": {
      "const": [
        "project",
        "project_id",
        "host",
        "run_id",
        "attempt",
        "cluster",
        "job_id",
        "array_parent",
        "array_task",
        "submission_token",
        "submit_time",
        "script_sha256",
        "timestamp",
        "timestamp_utc",
        "source_time",
        "clock",
        "elapsed_seconds",
        "sequence",
        "metric",
        "value",
        "unit",
        "phase",
        "step",
        "rank",
        "node",
        "source",
        "scope",
        "quality",
        "status",
        "reason"
      ]
    },
    "gpu": {
      "const": [
        "project",
        "project_id",
        "host",
        "run_id",
        "attempt",
        "cluster",
        "job_id",
        "array_parent",
        "array_task",
        "submission_token",
        "submit_time",
        "script_sha256",
        "timestamp",
        "timestamp_utc",
        "source_time",
        "clock",
        "elapsed_seconds",
        "sequence",
        "node",
        "provider",
        "device_uuid",
        "device_index",
        "device_bdf",
        "partition",
        "utilization_percent",
        "memory_used_mib",
        "memory_total_mib",
        "source",
        "scope",
        "quality",
        "status",
        "reason"
      ]
    },
    "cpu-memory": {
      "const": [
        "project",
        "project_id",
        "host",
        "run_id",
        "attempt",
        "cluster",
        "job_id",
        "array_parent",
        "array_task",
        "submission_token",
        "submit_time",
        "script_sha256",
        "timestamp",
        "timestamp_utc",
        "source_time",
        "clock",
        "elapsed_seconds",
        "sequence",
        "node",
        "cpu_seconds",
        "rss_bytes",
        "process_count",
        "source",
        "scope",
        "quality",
        "status",
        "reason"
      ]
    }
  },
  "additionalProperties": false
}
