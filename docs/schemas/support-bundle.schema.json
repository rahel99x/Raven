{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahel99x/Slurm-Tower/docs/schemas/support-bundle.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tower.support-bundle/v1"
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "reports"
  ],
  "additionalProperties": false
}
