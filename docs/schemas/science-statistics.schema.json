{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven statistics v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "raven.statistics/v1"
    },
    "design": {
      "enum": [
        "paired",
        "independent"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "confidence": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 0.999
    },
    "control": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value": {
            "type": "number",
            "minimum": -1e+100,
            "maximum": 1e+100
          }
        },
        "required": [
          "id",
          "value"
        ]
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "treatment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value": {
            "type": "number",
            "minimum": -1e+100,
            "maximum": 1e+100
          }
        },
        "required": [
          "id",
          "value"
        ]
      },
      "minItems": 1,
      "maxItems": 100000
    }
  },
  "required": [
    "schema",
    "design",
    "unit",
    "control",
    "treatment"
  ]
}
