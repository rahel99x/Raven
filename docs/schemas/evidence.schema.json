{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahel99x/Slurm-Tower/docs/schemas/evidence.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tower.evidence/v1"
    },
    "identity": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "job_id": {
          "type": "string",
          "pattern": "^[0-9]+(?:_[0-9]+)?(?:\\+[0-9]+)?(?:\\.[A-Za-z0-9_-]+)?$"
        },
        "attempt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "process_start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "thread": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "cluster",
        "job_id",
        "attempt"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "pid": [
          "node",
          "process_start"
        ]
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "format",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "unit": {
          "enum": [
            "s",
            "ms",
            "us",
            "ns",
            "unknown"
          ]
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "domain",
        "unit",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "events",
            "samples",
            "aggregates",
            "provenance",
            "mixed"
          ]
        },
        "complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 256
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "start",
              "end",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "mode",
        "complete",
        "scope",
        "gaps",
        "omitted"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "records",
        "reason"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "annotation",
              "artifact",
              "flow",
              "metric",
              "run",
              "span"
            ]
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 20000
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "version",
          "parameters"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "metadata": {
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "identity",
    "source",
    "clock",
    "coverage",
    "loss",
    "records",
    "transforms"
  ],
  "additionalProperties": false,
  "description": "Structural contract. Runtime validation also enforces unique record identities, exact source/digest integrity, finite numbers, completeness/loss consistency, and total size/depth limits."
}
