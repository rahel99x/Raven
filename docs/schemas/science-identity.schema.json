{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven requested reuse identity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs_sha256": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "project",
    "code_sha256",
    "environment_sha256",
    "parameters_sha256",
    "inputs_sha256"
  ]
}
