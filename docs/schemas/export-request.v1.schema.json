{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raven normalized retained-data export request v1",
  "description": "Normalized immutable selection. All excludes logs/artifacts. Local filesystem only; remote adapters fail explicitly. Exact run IDs, never ambiguous scheduler job-number resolution.",
  "type": "object",
  "required": [
    "schema",
    "attempts",
    "include",
    "layout",
    "destination"
  ],
  "properties": {
    "schema": {
      "const": "raven.export-request/v1"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "project",
          "run_id",
          "host"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "host": {
            "type": "string"
          }
        }
      }
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "application",
          "gpu",
          "cpu-memory",
          "summary",
          "research",
          "trace",
          "logs",
          "artifacts"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "reports": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "start": {
      "type": [
        "number",
        "null"
      ]
    },
    "end": {
      "type": [
        "number",
        "null"
      ]
    },
    "layout": {
      "enum": [
        "category",
        "metric"
      ]
    },
    "destination": {
      "type": "object",
      "required": [
        "mode",
        "path",
        "host",
        "combined"
      ],
      "properties": {
        "mode": {
          "enum": [
            "project",
            "relative",
            "absolute"
          ]
        },
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "combined": {
          "type": "boolean"
        }
      }
    },
    "preset": {},
    "range_policy": {
      "type": "string"
    },
    "all_available": {
      "type": "boolean",
      "description": "Select retained available families in addition to explicit_include; all excludes logs and artifacts."
    },
    "explicit_include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
